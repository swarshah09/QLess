# ---------------------------------------------------------------------------
# QLess backend environment configuration
# Copy to .env and fill in real values. NEVER commit a populated .env file.
# ---------------------------------------------------------------------------

# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/qless?schema=public"

# Frontend origin(s) allowed by CORS. Comma-separate for multiple origins.
FRONTEND_URL=http://localhost:5173

# Auth secrets. MUST be different from each other, and must not keep these
# placeholder values in production — startup refuses to boot if they do.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string

# Token lifetimes. Access tokens are stateless and cannot be revoked early, so
# keep this short; refresh sessions are revocable and may live longer.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# bcrypt work factor (10-15).
BCRYPT_ROUNDS=12

# Geofence radius in metres. A crowd report submitted from inside this distance
# of a station counts as a first-hand sighting (VERIFIED_NEARBY_USER); outside
# it the report is still stored but weighted lower (NORMAL_USER). Tighten for
# dense urban forecourts, loosen for highway stations.
LOCATION_VERIFICATION_RADIUS_M=200

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address push services use for abuse reports (required by the VAPID
# spec). Without the two keys above the engine still evaluates rules and records
# events — it just marks them SUPPRESSED instead of delivering.
VAPID_SUBJECT=support@qless.example

# Logging
LOG_LEVEL=info

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Request body size limit
JSON_BODY_LIMIT=100kb
