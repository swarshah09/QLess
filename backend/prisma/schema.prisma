// QLess — CNG queue platform
// Backend Part 1: database architecture.
//
// Design notes that matter for later phases:
//  * StationStatus is a COMPUTED projection. Raw reports (QueueReport,
//    AvailabilityReport, PressureReport) are the historical source of truth and
//    are never mutated or deleted by the status computation.
//  * Queue sizes are stored as an inclusive [queueMin, queueMax] range. An
//    unknown queue is represented by BOTH bounds being null — never by 0.
//  * Pressure thresholds are configured per station (with platform defaults),
//    never hard-coded as universal constants.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  STATION_OPERATOR
  ADMIN
}

enum Availability {
  AVAILABLE
  LOW_SUPPLY
  TEMPORARILY_INTERRUPTED
  UNAVAILABLE
  UNKNOWN
}

/// Who produced a report. Both operators and normal users can report, and the
/// source materially changes how much weight a report carries.
enum ReportSource {
  OPERATOR
  VERIFIED_NEARBY_USER
  NORMAL_USER
  ADMIN
  SYSTEM_ESTIMATE
}

/// Canonical queue buckets exposed to clients. Stored alongside the numeric
/// range so the range stays the source of truth for computation.
enum QueueBucket {
  RANGE_0_3
  RANGE_4_7
  RANGE_8_15
  RANGE_16_25
  RANGE_25_PLUS
  UNKNOWN
}

enum PressureUnit {
  BAR
  PSI
  KPA
}

/// Interpretation of a pressure value RELATIVE to the station's own
/// configured thresholds. Never derived from a global constant.
enum PressureStatus {
  NORMAL
  LOW
  CRITICAL
  UNKNOWN
}

/// Age bands for the computed status. Cutoffs are configurable via
/// FRESHNESS_THRESHOLDS_MINUTES; these names are the stable client contract.
/// EXPIRED sits past STALE for data so old it should not be shown as current.
enum Freshness {
  LIVE
  RECENT
  AGING
  STALE
  EXPIRED
  UNKNOWN
}

/// Discrete supply-side occurrences at a station.
///
/// The first four are the operator-facing set. `SUPPLY_ARRIVED` and
/// `TEMPORARY_INTERRUPTION` were previously named `REFILL_RECEIVED` and
/// `SUPPLY_INTERRUPTED`; they were renamed rather than duplicated so there is
/// exactly one way to express each real-world occurrence.
enum SupplyEventType {
  SUPPLY_ARRIVED
  LOW_SUPPLY
  CNG_FINISHED
  TEMPORARY_INTERRUPTION
  SUPPLY_RESTORED
  MAINTENANCE_START
  MAINTENANCE_END
  STATION_CLOSED
  STATION_REOPENED
}

/// Delivery channels for notifications. Only the model is built in Part 1;
/// delivery arrives in a later phase.
enum NotificationChannel {
  WEB_PUSH
  IN_APP
  EMAIL
  SMS
}

enum NotificationEventStatus {
  PENDING
  SENT
  FAILED
  SUPPRESSED
}

/// Whether a notification rule's conditions are currently satisfied. Used to
/// fire only on transitions rather than repeatedly while conditions hold.
enum RuleConditionState {
  UNMET
  MET
  UNKNOWN
}

enum StationOperatorRole {
  MANAGER
  STAFF
}

enum MetricInterval {
  HOURLY
  DAILY
}

/// Terminal outcome of a station visit. Leaving the station is explicitly NOT
/// treated as successful refuelling — the outcome must be established
/// separately, and stays UNKNOWN until then.
enum VisitOutcome {
  UNKNOWN
  REFUELLED
  ABANDONED_QUEUE
  STATION_UNAVAILABLE
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id    String  @id @default(uuid()) @db.Uuid
  name  String  @db.VarChar(120)
  email String? @unique @db.VarChar(255)
  phone String? @unique @db.VarChar(20)

  role UserRole @default(USER)

  /// Nullable by design: a user authenticated by OTP or magic link has no
  /// password at all. Credential verification is strategy-based, so this field
  /// belongs to the password strategy only.
  passwordHash    String?   @db.VarChar(255)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  active          Boolean   @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  authSessions        AuthSession[]
  operatorAssignments StationOperator[]
  queueReports        QueueReport[]
  availabilityReports AvailabilityReport[]
  pressureReports     PressureReport[]
  supplyEvents        SupplyEvent[]
  visits              StationVisit[]
  notificationRules   NotificationRule[]
  pushSubscriptions   PushSubscription[]
  notificationEvents  NotificationEvent[]
  savedStations       SavedStation[]
  reputation          ReporterReputation?
  adminAuditLogs      AdminAuditLog[]

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

/// How a session's owner proved their identity. Password is the MVP; the other
/// values exist so OTP / magic-link strategies can be added without touching
/// session handling or token issuance.
enum AuthMethod {
  PASSWORD
  OTP
  MAGIC_LINK
}

/// A refresh-token session. Access tokens are stateless JWTs; refresh tokens are
/// opaque random strings stored ONLY as a SHA-256 hash, so a database leak does
/// not yield usable tokens.
///
/// Rotation: each refresh issues a new token and revokes the old one, keeping
/// `familyId` constant. Presenting an already-revoked token means it leaked, so
/// the entire family is revoked at once.
model AuthSession {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the refresh token. The token itself is never persisted.
  tokenHash String @unique @db.VarChar(64)

  /// Shared across every rotation descended from one login, for reuse detection.
  familyId String @db.Uuid

  method AuthMethod @default(PASSWORD)

  expiresAt     DateTime
  revokedAt     DateTime?
  /// Why the session ended — useful when auditing a suspected token leak.
  revokedReason String?   @db.VarChar(80)

  ipAddress String? @db.VarChar(64)
  userAgent String? @db.VarChar(400)

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

/// Trust signal for a reporter, updated by a later scoring job. Kept separate
/// from User so reputation can be recomputed without touching identity data.
model ReporterReputation {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  score           Int @default(50) // 0-100
  totalReports    Int @default(0)
  verifiedReports Int @default(0)
  rejectedReports Int @default(0)

  lastReportAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([score])
  @@map("reporter_reputations")
}

// ---------------------------------------------------------------------------
// Stations
// ---------------------------------------------------------------------------

model Station {
  id      String  @id @default(uuid()) @db.Uuid
  name    String  @db.VarChar(160)
  address String  @db.VarChar(400)
  city    String? @db.VarChar(120)
  state   String? @db.VarChar(120)
  pincode String? @db.VarChar(12)

  // Distance-based discovery is a core product feature, so coordinates are
  // mandatory for every station.
  latitude  Float
  longitude Float

  /// Weekly opening hours, e.g. { "mon": [{ "open": "06:00", "close": "22:00" }] }
  operatingHours Json?

  active             Boolean @default(true)
  numberOfDispensers Int     @default(1)

  // Per-station pressure thresholds. Platform defaults are applied at the
  // config layer when these are null.
  pressureThresholdLow    Float?
  pressureThresholdNormal Float?
  defaultPressureUnit     PressureUnit @default(BAR)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status              StationStatus?
  operators           StationOperator[]
  queueReports        QueueReport[]
  availabilityReports AvailabilityReport[]
  pressureReports     PressureReport[]
  supplyEvents        SupplyEvent[]
  visits              StationVisit[]
  notificationRules   NotificationRule[]
  notificationEvents  NotificationEvent[]
  savedBy             SavedStation[]
  historicalMetrics   StationHistoricalMetric[]
  statusSnapshots     StationStatusSnapshot[]

  @@index([active])
  /// Nearby discovery filters on `active` and then a lat/lng bounding box in
  /// one query; the composite lets that be served by a single index scan.
  @@index([active, latitude, longitude])
  @@index([latitude, longitude])
  @@index([city])
  @@index([name])
  @@map("stations")
}

model StationOperator {
  id String @id @default(uuid()) @db.Uuid

  userId    String  @db.Uuid
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  stationId String  @db.Uuid
  station   Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  role   StationOperatorRole @default(STAFF)
  active Boolean             @default(true)

  assignedAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, stationId])
  @@index([stationId, active])
  /// "Which stations may this operator act on?" — the authorization hot path.
  @@index([userId, active])
  @@map("station_operators")
}

/// COMPUTED current state of a station — one row per station, overwritten by
/// the status computation. Never read this as history; use the *Report tables.
model StationStatus {
  id        String  @id @default(uuid()) @db.Uuid
  stationId String  @unique @db.Uuid
  station   Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  availability Availability @default(UNKNOWN)

  // Null on BOTH bounds means "unknown queue" — it must never be read as zero.
  queueMin    Int?
  queueMax    Int?
  queueBucket QueueBucket @default(UNKNOWN)

  // Estimated wait range in minutes. Null means unknown, not zero.
  waitMin Int?
  waitMax Int?

  pressureValue  Float?
  pressureUnit   PressureUnit   @default(BAR)
  pressureStatus PressureStatus @default(UNKNOWN)

  activeDispensers Int?

  /// 0-100. Produced by the confidence algorithm in a later phase.
  confidence Int       @default(0)
  freshness  Freshness @default(UNKNOWN)

  computedAt DateTime @default(now())

  lastOperatorUpdateAt DateTime?
  lastUserUpdateAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([availability])
  @@index([freshness])
  @@index([computedAt])
  @@map("station_statuses")
}

// ---------------------------------------------------------------------------
// Raw reports (historical source of truth — append-only)
// ---------------------------------------------------------------------------

model QueueReport {
  id        String  @id @default(uuid()) @db.Uuid
  stationId String  @db.Uuid
  station   Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  // Null reporter means a SYSTEM_ESTIMATE.
  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Null on both bounds means the reporter explicitly did not know.
  queueMin    Int?
  queueMax    Int?
  queueBucket QueueBucket @default(UNKNOWN)

  source ReportSource

  locationVerified   Boolean @default(false)
  reportedLatitude   Float?
  reportedLongitude  Float?
  distanceToStationM Float?

  createdAt DateTime @default(now())

  @@index([stationId, createdAt])
  @@index([userId, createdAt])
  @@index([source])
  /// Admin review scans by source over a recent window.
  @@index([source, createdAt])
  @@map("queue_reports")
}

model AvailabilityReport {
  id        String  @id @default(uuid()) @db.Uuid
  stationId String  @db.Uuid
  station   Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  availability Availability
  source       ReportSource
  note         String?      @db.VarChar(500)

  /// How many dispensers were actually serving at the time. In practice only
  /// operators know this, so it is usually null on user reports. It lives here
  /// rather than on StationStatus alone so the dispenser count has a history
  /// like every other observation.
  activeDispensers Int?

  locationVerified   Boolean @default(false)
  reportedLatitude   Float?
  reportedLongitude  Float?
  distanceToStationM Float?

  createdAt DateTime @default(now())

  @@index([stationId, createdAt])
  @@index([userId, createdAt])
  @@index([source])
  /// Admin review scans by source over a recent window.
  @@index([source, createdAt])
  @@map("availability_reports")
}

model PressureReport {
  id        String  @id @default(uuid()) @db.Uuid
  stationId String  @db.Uuid
  station   Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  pressureValue Float
  pressureUnit  PressureUnit @default(BAR)
  source        ReportSource

  locationVerified   Boolean @default(false)
  reportedLatitude   Float?
  reportedLongitude  Float?
  distanceToStationM Float?

  createdAt DateTime @default(now())

  @@index([stationId, createdAt])
  @@index([userId, createdAt])
  @@index([source])
  /// Admin review scans by source over a recent window.
  @@index([source, createdAt])
  @@map("pressure_reports")
}

/// Discrete supply-side occurrences at a station (refill trucks, outages,
/// maintenance). Drives availability explanations and future forecasting.
model SupplyEvent {
  id        String  @id @default(uuid()) @db.Uuid
  stationId String  @db.Uuid
  station   Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  reportedByUserId String? @db.Uuid
  reportedBy       User?   @relation(fields: [reportedByUserId], references: [id], onDelete: SetNull)

  type   SupplyEventType
  source ReportSource
  note   String?         @db.VarChar(500)

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stationId, startedAt])
  @@index([type])
  @@map("supply_events")
}

// ---------------------------------------------------------------------------
// User activity
// ---------------------------------------------------------------------------

/// A user's trip to a station. completedAt records only that the visit ended;
/// whether refuelling actually succeeded lives in `outcome` and defaults to
/// UNKNOWN.
model StationVisit {
  id String @id @default(uuid()) @db.Uuid

  userId    String  @db.Uuid
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  stationId String  @db.Uuid
  station   Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  locationVerified Boolean @default(false)

  arrivedAt     DateTime?
  joinedQueueAt DateTime?
  completedAt   DateTime?

  outcome VisitOutcome @default(UNKNOWN)

  /// Observed wait in minutes, only set when it can be measured reliably.
  observedWaitMinutes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([stationId, createdAt])
  @@index([outcome])
  @@map("station_visits")
}

model SavedStation {
  id String @id @default(uuid()) @db.Uuid

  userId    String  @db.Uuid
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  stationId String  @db.Uuid
  station   Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  label     String?  @db.VarChar(80)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, stationId])
  @@index([userId, sortOrder])
  @@map("saved_stations")
}

// ---------------------------------------------------------------------------
// Notifications (models only in Part 1 — delivery lands in a later phase)
// ---------------------------------------------------------------------------

model NotificationRule {
  id String @id @default(uuid()) @db.Uuid

  userId    String  @db.Uuid
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  stationId String  @db.Uuid
  station   Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  /// Any of these availabilities satisfies the rule. Empty means "any".
  requiredAvailability Availability[] @default([])

  maxQueue       Int?
  maxWaitMinutes Int?
  minPressure    Float?
  pressureUnit   PressureUnit @default(BAR)

  channel NotificationChannel @default(WEB_PUSH)
  enabled Boolean             @default(true)

  /// Tracks whether conditions currently hold, so the rule fires on the
  /// transition into MET rather than on every evaluation.
  currentConditionState RuleConditionState @default(UNKNOWN)

  lastEvaluatedAt DateTime?
  lastTriggeredAt DateTime?
  cooldownUntil   DateTime?
  cooldownMinutes Int       @default(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events NotificationEvent[]

  @@unique([userId, stationId, channel])
  @@index([stationId, enabled])
  @@index([enabled, currentConditionState])
  @@index([cooldownUntil])
  @@map("notification_rules")
}

model PushSubscription {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint String @unique @db.VarChar(1000)
  p256dh   String @db.VarChar(255)
  auth     String @db.VarChar(255)

  userAgent String? @db.VarChar(400)
  active    Boolean @default(true)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime?

  events NotificationEvent[]

  @@index([userId, active])
  @@map("push_subscriptions")
}

model NotificationEvent {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ruleId String?           @db.Uuid
  rule   NotificationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  stationId String?  @db.Uuid
  station   Station? @relation(fields: [stationId], references: [id], onDelete: SetNull)

  subscriptionId String?           @db.Uuid
  subscription   PushSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  channel NotificationChannel     @default(WEB_PUSH)
  status  NotificationEventStatus @default(PENDING)

  /// Deterministic key derived from (rule, the transition that fired it).
  /// Unique, so re-processing the same StationStatus change cannot create a
  /// second event — the duplicate insert simply loses the race and is ignored.
  dedupeKey String @unique @db.VarChar(200)

  title   String @db.VarChar(160)
  body    String @db.VarChar(500)
  /// Arbitrary client payload (deep links, station snapshot, etc.).
  payload Json?

  /// Snapshot of the conditions that triggered the event, for debugging.
  triggerSnapshot Json?

  error       String?   @db.VarChar(1000)
  attempts    Int       @default(0)
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, scheduledAt])
  @@index([stationId, createdAt])
  @@index([ruleId, createdAt])
  @@map("notification_events")
}

// ---------------------------------------------------------------------------
// Analytics & audit
// ---------------------------------------------------------------------------

/// Pre-aggregated station metrics per time bucket. Populated by a later job;
/// no prediction/AI logic is implemented in Part 1.
model StationHistoricalMetric {
  id        String  @id @default(uuid()) @db.Uuid
  stationId String  @db.Uuid
  station   Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  interval    MetricInterval @default(HOURLY)
  bucketStart DateTime
  /// 0 = Sunday .. 6 = Saturday, denormalised for time-of-week analysis.
  dayOfWeek   Int
  hourOfDay   Int

  avgQueueMin    Float?
  avgQueueMax    Float?
  avgWaitMinutes Float?
  avgPressure    Float?
  pressureUnit   PressureUnit @default(BAR)

  /// Share of samples in the bucket that were AVAILABLE, 0..1.
  availabilityRate     Float?
  dominantAvailability Availability @default(UNKNOWN)

  /// Demand proxies for the bucket.
  visitCount  Int @default(0)
  reportCount Int @default(0)
  sampleCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([stationId, interval, bucketStart])
  @@index([stationId, dayOfWeek, hourOfDay])
  @@map("station_historical_metrics")
}

/// Append-only snapshot of a computed StationStatus at a moment in time.
///
/// StationStatus itself is overwritten on every recomputation, so without this
/// there is no record of what the platform actually told drivers. Snapshots are
/// derived data — the raw reports remain the source of truth — but they make
/// past advice auditable and feed the historical metrics rollup later.
model StationStatusSnapshot {
  id        String  @id @default(uuid()) @db.Uuid
  stationId String  @db.Uuid
  station   Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  availability Availability
  queueMin     Int?
  queueMax     Int?
  queueBucket  QueueBucket  @default(UNKNOWN)
  waitMin      Int?
  waitMax      Int?

  pressureValue  Float?
  pressureUnit   PressureUnit   @default(BAR)
  pressureStatus PressureStatus @default(UNKNOWN)

  activeDispensers Int?
  confidence       Int
  freshness        Freshness

  /// How many reports of each kind fed this computation, for later analysis of
  /// why a given status was produced.
  queueSampleCount        Int @default(0)
  availabilitySampleCount Int @default(0)
  pressureSampleCount     Int @default(0)
  /// Reports discarded as outliers when this snapshot was computed.
  outlierCount            Int @default(0)

  computedAt DateTime @default(now())

  @@index([stationId, computedAt])
  @@map("station_status_snapshots")
}

model AdminAuditLog {
  id String @id @default(uuid()) @db.Uuid

  adminUserId String? @db.Uuid
  adminUser   User?   @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  action     String  @db.VarChar(120)
  entityType String  @db.VarChar(80)
  entityId   String? @db.VarChar(64)

  /// Why the admin acted. Required for manual station overrides — an override
  /// without a stated reason is not auditable after the fact.
  reason String? @db.VarChar(500)

  before Json?
  after  Json?

  ipAddress String? @db.VarChar(64)
  userAgent String? @db.VarChar(400)

  createdAt DateTime @default(now())

  @@index([adminUserId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("admin_audit_logs")
}
